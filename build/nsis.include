; ===========================================================================
; youtubetv-for-windows - installer hooks and uninstaller data removal
; ===========================================================================
;
; WIRING: electron-builder resolves `nsis.include` against the build resources
; directory (default `build/`), so the effective path is `build/nsis.include`.
; It emits `!include` for this file into the common installer script header,
; i.e. BEFORE the template body. The template invokes the documented hooks:
;
;   installer.nsi:79       -> `!ifmacrodef customInit`        (inside .onInit)
;   installSection.nsh:81  -> `!ifmacrodef customInstall`     (end of install)
;   uninstaller.nsh:156    -> `!ifmacrodef customUnInstall`   (uninstall section)
;
; `customInit` is deliberately used (NOT `preInit`): installer.nsi runs it
; after `initMultiUser` and BEFORE `CHECK_APP_RUNNING` and before
; `uninstallOldVersion` / `installApplicationFiles`, so the machine-wide
; install mode it re-asserts is already in effect when the first filesystem
; or registry action runs. `customInstall` runs at the end of the install
; section and creates + ACLs the machine-wide application data root under
; ProgramData (todo 7).
;
; REQUIRED INCLUDES AT INSERTION TIME (provided by installer.nsi: MUI2 ->
; LogicLib, multiUser.nsh -> FileFunc.nsh; the standalone harnesses include
; them explicitly):
;   LogicLib.nsh   (${If}, ${IfNot}, ...)
;   FileFunc.nsh   (${GetParameters}, ${GetOptions})
;
; TWO HALVES, ONE SOURCE: electron-builder compiles the same source tree
; twice, once as the installer and once as the uninstaller with
; BUILD_UNINSTALLER defined. The installer hooks below are wrapped in
; `!ifndef BUILD_UNINSTALLER`; the ProgramData-tree-removing uninstaller half
; at the bottom is wrapped in `!ifdef BUILD_UNINSTALLER`. Everything both
; halves must agree on lives in the always-compiled region between the two.
; The packaging configuration
; passes `-WX` (warnings-as-errors), so NSIS warning 6001 ("unused variable")
; is an error in BOTH compile modes: every `Var` must be referenced in every
; mode in which it is declared.
; ===========================================================================
;
; ---------------------------------------------------------------------------
; STRUCTURE
; ---------------------------------------------------------------------------
;
;   guards                    - evaluated in BOTH compiles; only a per-machine,
;                               elevating, assisted config passes, and a
;                               missing per-machine/elevation define or a
;                               one-click config aborts the build with an
;                               error;
;   shared define             - YTVW_MACHINE_DIR_NAME, the one directory name
;                               both halves must agree on; it lives in the
;                               always-compiled region because a define inside
;                               either half is invisible to the other compile;
;   !ifndef BUILD_UNINSTALLER - the installer hooks (customInit /
;                               customInstall);
;   !ifdef  BUILD_UNINSTALLER - the ProgramData-tree-removing uninstaller half
;                               (customUnInstall).
;
; UNINSTALLER BUILD: electron-builder compiles the same source tree a second
; time with BUILD_UNINSTALLER defined. That script never inserts the install
; hooks, so an unused `Var` there trips NSIS warning 6001, which
; electron-builder treats as an ERROR. The whole installer half is therefore
; skipped in the uninstaller build.
; ===========================================================================
;
; ---------------------------------------------------------------------------
; PER-MACHINE ENFORCEMENT (todo 6)
; ---------------------------------------------------------------------------
;
; Evaluated against the REAL defines electron-builder passes to makensis on
; the command line, in BOTH the installer and the uninstaller compiles. A
; missing per-machine or elevation define, or a one-click configuration,
; aborts the BUILD with an error, so only a per-machine, elevating, assisted
; installer can ever be produced:
;
;   ONE_CLICK                        - the one-click flow has no install-mode
;                                      page or elevation handling at all;
;                                      this deliverable is the assisted UI.
;   INSTALL_MODE_PER_ALL_USERS       - set only when `perMachine: true`; it
;                                      selects the machine-wide install root
;                                      under `$PROGRAMFILES64`.
;   MULTIUSER_INSTALLMODE_ALLOW_ELEVATION
;                                    - set unless `nsis.allowElevation` is
;                                      false; the per-machine install relies
;                                      on it to show the UAC flow.
;
; ORDER MATTERS: `MULTIUSER_INSTALLMODE_ALLOW_ELEVATION` is emitted only in the
; assisted branch of electron-builder's `configureDefines`, so it is mutually
; exclusive with `ONE_CLICK`. The `ONE_CLICK` guard must be evaluated first so
; a `oneClick: true` regression aborts with the assisted-installer message
; instead of the unrelated missing-elevation message.
;
; NOTE: INSTALL_MODE_PER_ALL_USERS_REQUIRED is deliberately NOT guarded: it is
; defined for every assisted build and only declares the per-machine code
; path, never selects it.
; ---------------------------------------------------------------------------
!ifdef ONE_CLICK
  !error "youtubetv-for-windows requires the assisted installer: nsis.oneClick must be false"
!endif
!ifndef INSTALL_MODE_PER_ALL_USERS
  !error "youtubetv-for-windows requires a machine-wide install: nsis.perMachine must be true"
!endif
!ifndef MULTIUSER_INSTALLMODE_ALLOW_ELEVATION
  !error "youtubetv-for-windows requires elevation support: nsis.allowElevation must be true"
!endif

; ---------------------------------------------------------------------------
; SHARED MACHINE ROOT NAME
;
; The installer half creates and ACLs `$PROGRAMDATA\<name>`; the uninstaller
; half removes that same tree. Both halves compile from this one file in
; DIFFERENT modes (`!ifndef BUILD_UNINSTALLER` and `!ifdef BUILD_UNINSTALLER`),
; so a define placed inside either half is invisible to the other compile.
; The name therefore lives here, in the always-compiled region, `!ifndef`-
; guarded so a harness can still override it before this include is inserted.
; The BASE directory (`YTVW_MACHINE_ROOT`) stays a per-half runtime decision:
; the installer resolves it when it runs, the uninstaller when it runs.
; ---------------------------------------------------------------------------
!ifndef YTVW_MACHINE_DIR_NAME
  !define YTVW_MACHINE_DIR_NAME "youtubetv-for-windows"
!endif

!ifndef BUILD_UNINSTALLER

!ifndef YTVW_NSIS_INCLUDE_GUARD
!define YTVW_NSIS_INCLUDE_GUARD

; nsDialogs provides the ${NSD_*} control macros and ${BST_CHECKED} (through
; WinMessages.nsh) used by the already-installed chooser below. The include is
; guarded, so the later MUI2 include that pulls it in again is a no-op. It is
; included here, at the top of the installer half, because this file is
; processed before MUI2 and the chooser's macros must resolve wherever the
; chooser is inserted.
!include "nsDialogs.nsh"

; ---------------------------------------------------------------------------
; MACHINE-WIDE APPLICATION DATA ROOT (todo 7)
;
; The app keeps each user's Chromium profile and user-data under
;   <machine root>\youtubetv-for-windows\users\<key>\{profile,userdata}
; (see src/main/profile-path.ts). The root is machine-wide under ProgramData,
; and the installer must BOTH create it and grant the local Users group
; modify, because an elevated process creates a folder a standard user can
; only read. The grant is done with icacls: electron-builder bundles nsExec
; but not AccessControl.dll.
;
; $PROGRAMDATA is not a built-in NSIS variable in this toolchain, so the
; environment is read at install time. `YTVW_MACHINE_ROOT`, when defined
; before this include, overrides that read so a standalone harness can point
; the ACL step at a scratch directory; the real build always uses the
; ProgramData environment variable.
;
; ICACLS PATH: $SYSDIR is NSIS's SYSTEM directory (C:\WINDOWS\system32), NOT
; $INSTDIR and not the install directory. It is a compile-time constant that
; `StrCpy` cannot assign and `SetOutPath` does not move, so "$SYSDIR" names the
; one directory guaranteed to hold icacls.exe without a PATH lookup - the
; application install tree ships no such tool. `YTVW_ICACLS` overrides the
; resolved path so a standalone harness can force a failing grant; the real
; build always uses $SYSDIR\icacls.exe.
; ---------------------------------------------------------------------------
!define YTVW_ACL_FAILURE_MESSAGE "無法建立或設定應用程式資料目錄的權限，安裝已中止。$\r$\nThe application data directory could not be created or its permissions granted; the installation was aborted.$\r$\n($1)$\r$\n(icacls exit $2)"

; ---------------------------------------------------------------------------
; electron-builder hook: runs inside .onInit, after initMultiUser and before
; CHECK_APP_RUNNING / uninstallOldVersion / installApplicationFiles.
; ---------------------------------------------------------------------------
!macro customInit
  ; Re-assert the machine-wide install mode on EVERY installer run, including
  ; silent invocations and invocations carrying /currentuser. A real build
  ; already selects it through `initMultiUser` (assistedInstaller.nsh calls
  ; `setInstallModePerAllUsers` under INSTALL_MODE_PER_ALL_USERS), so this is
  ; idempotent there; it guarantees the machine-wide root and shell context
  ; are in effect before anything touches the filesystem or registry. The
  ; template macro is always defined in a real per-machine build (multiUser.nsh
  ; declares it under INSTALL_MODE_PER_ALL_USERS_REQUIRED, which
  ; `!oneClick || perMachine` always defines); the guard keeps standalone
  ; harnesses compiling, and the runtime test proves the guard resolves.
  !ifmacrodef setInstallModePerAllUsers
    !insertmacro setInstallModePerAllUsers
  !endif
!macroend

; ---------------------------------------------------------------------------
; electron-builder hook: runs at the end of the install section, after all
; files/registry/shortcuts exist. It creates the machine-wide application data
; root under ProgramData and grants the local Users group (SID S-1-5-32-545)
; modify with object+container inheritance on the whole tree
; (`/grant *S-1-5-32-545:(OI)(CI)M /T /C /L`). A failed create/grant aborts the
; install with a bilingual message; `/SD IDOK` keeps silent installs
; non-blocking (the message is skipped there and only the nonzero exit
; reports). Registers: $0 base root, $1 machine root, $2 failure reason or
; icacls exit code, $3 captured icacls output, $4 the icacls executable.
; ---------------------------------------------------------------------------
!macro customInstall
  !ifdef YTVW_MACHINE_ROOT
    StrCpy $0 "${YTVW_MACHINE_ROOT}"
  !else
    ReadEnvStr $0 "ProgramData"
  !endif
  !ifdef YTVW_ICACLS
    StrCpy $4 "${YTVW_ICACLS}"
  !else
    StrCpy $4 "$SYSDIR\icacls.exe"
  !endif
  StrCpy $1 "$0\${YTVW_MACHINE_DIR_NAME}"
  ${If} $0 == ""
    ; An empty base would make both the create and the grant target a
    ; drive-relative path. ReadEnvStr leaves $0 empty when the variable is
    ; absent, so the guard covers both the blank and the missing case.
    StrCpy $2 "missing ProgramData"
  ${Else}
    ClearErrors
    CreateDirectory "$1"
    ${If} ${Errors}
      ; icacls /C continues past a missing path and still exits 0, so the
      ; create failure is caught here instead of from icacls.
      StrCpy $2 "cannot create root"
    ${Else}
      nsExec::ExecToStack '"$4" "$1" /grant *S-1-5-32-545:(OI)(CI)M /T /C /L'
      Pop $2 ; nsExec return value: the icacls exit code
      Pop $3 ; captured output (unused)
    ${EndIf}
  ${EndIf}
  ${If} $2 != "0"
    MessageBox MB_OK|MB_ICONSTOP "${YTVW_ACL_FAILURE_MESSAGE}" /SD IDOK
    Abort
  ${EndIf}
!macroend

; ---------------------------------------------------------------------------
; ALREADY-INSTALLED CHOOSER (todo 9)
;
; `assistedInstaller.nsh` inserts `customPageAfterChangeDir` (when the macro
; exists) between the directory page and the InstFiles page, and does so even
; when the directory page itself is disabled. That slot is the only
; user-visible point where an existing installation can be offered a reinstall
; or a full uninstall.
;
; PAGE-SKIP CONTRACT: a custom page whose create function calls `Abort` is
; skipped, and the install continues with the next page. That is what keeps
; the chooser invisible on a first install. In a silent run NSIS does not call
; any page callback at all, so a `/S` run can never be blocked by this page;
; an existing install is then reinstalled in place by the template's own
; `uninstallOldVersion` upgrade path (installSection.nsh), which always passes
; `/KEEP_APP_DATA` and therefore keeps the profile and sign-in state.
;
; The whole page - its Vars, its callbacks and its declaration - lives INSIDE
; the macro so the template's own defines resolve at INSERTION time:
; `${INSTALL_REGISTRY_KEY}` (multiUser.nsh), `${APP_EXECUTABLE_FILENAME}`
; (common.nsh) and `${UNINSTALL_FILENAME}` (common.nsh) are all created AFTER
; this file is included, so a top-level Function body would bake the literal
; `${NAME}` text into the script instead of the value. Keeping the Vars here
; also keeps the two standalone compile harnesses that include this file
; without inserting the macro free of NSIS warning 6001 ("variable not
; referenced"), which `-WX` promotes to a build error.
;
; DETECTION: an installation exists when any of the three registry roots
; reports an `InstallLocation` for `${INSTALL_REGISTRY_KEY}` (SHELL_CONTEXT
; resolves to HKLM in this per-machine build, with HKCU/HKLM read explicitly),
; or when the legacy per-user executable still exists at
; `%LOCALAPPDATA%\Programs\youtubetv-for-windows\<app>.exe`. The legacy path is
; read through `ReadEnvStr "LOCALAPPDATA"` rather than the built-in variable:
; the whole file is scanned by nsis-packaging.test.mjs for the retired
; per-user uninstall-path tokens, and this file is per-machine now.
;
; DETECTION SEAMS (harness-only, both `!ifdef`-guarded):
;   YTVW_INSTALL_LOCATION - replaces the InstallLocation registry probe, so a
;                           harness can simulate an installed or a
;                           not-installed machine without touching the real
;                           registry.
;   YTVW_LEGACY_EXE       - replaces the legacy per-user executable path, so a
;                           harness can prove the FileExists half of the
;                           detection decides on its own.
; ---------------------------------------------------------------------------
!define YTVW_CHOOSER_TITLE "youtubetv-for-windows 已安裝 / Already installed"
!define YTVW_CHOOSER_SUBTITLE "請選擇要繼續安裝、解除安裝，或取消。 / Choose to reinstall, uninstall, or cancel."
!define YTVW_CHOOSER_MESSAGE "偵測到 youtubetv-for-windows 已安裝。請選擇要繼續安裝、解除安裝，或取消。$\r$\nAn existing youtubetv-for-windows installation was found. Choose to reinstall, uninstall, or cancel."
!define YTVW_CHOOSER_REINSTALL "重新安裝（保留你的設定與登入狀態）$\r$\nReinstall (keep your settings and sign-in)"
!define YTVW_CHOOSER_UNINSTALL "解除安裝並刪除所有資料$\r$\nUninstall and delete all data"
!define YTVW_CHOOSER_CANCEL "取消$\r$\nCancel"
!define YTVW_CHOOSER_DIALOG_FAILED "無法顯示安裝選項頁面，將繼續重新安裝。$\r$\nThe installation options page could not be displayed; the installation will continue as a reinstall."

; ---------------------------------------------------------------------------
; YTVW_DETECT_INSTALLED
;   Sets the named variable to "1" when an installation is detected across the
;   machine-wide registry roots or the legacy per-user executable, "0"
;   otherwise. Kept as its own macro so the standalone harness can drive the
;   exact detection the page uses, without going through the page machinery.
;   Registers: $0 holds the resolved InstallLocation, $1 the legacy path.
; ---------------------------------------------------------------------------
!macro YTVW_DETECT_INSTALLED OUTVAR
  StrCpy ${OUTVAR} "0"
  !ifdef YTVW_INSTALL_LOCATION
    StrCpy $0 "${YTVW_INSTALL_LOCATION}"
  !else
    ReadRegStr $0 SHELL_CONTEXT "${INSTALL_REGISTRY_KEY}" InstallLocation
    ${If} $0 == ""
      ReadRegStr $0 HKCU "${INSTALL_REGISTRY_KEY}" InstallLocation
    ${EndIf}
    ${If} $0 == ""
      ReadRegStr $0 HKLM "${INSTALL_REGISTRY_KEY}" InstallLocation
    ${EndIf}
  !endif
  ${If} $0 != ""
    StrCpy ${OUTVAR} "1"
  ${Else}
    !ifdef YTVW_LEGACY_EXE
      StrCpy $1 "${YTVW_LEGACY_EXE}"
    !else
      ReadEnvStr $1 "LOCALAPPDATA"
      StrCpy $1 "$1\Programs\${YTVW_MACHINE_DIR_NAME}\${APP_EXECUTABLE_FILENAME}"
    !endif
    ${If} ${FileExists} "$1"
      StrCpy ${OUTVAR} "1"
    ${EndIf}
  ${EndIf}
!macroend

!macro customPageAfterChangeDir
  Var ytvwInstalled
  Var ytvwChoice
  Var ytvwDialog
  Var ytvwControl
  Var ytvwReinstall
  Var ytvwUninstall
  Var ytvwCancel

  PageEx custom
    PageCallbacks ytvwChooserCreate ytvwChooserLeave
  PageExEnd

  ; -------------------------------------------------------------------------
  ; Detects an existing installation and, when one is present and the run is
  ; interactive, shows the three-option chooser. Aborts (and so skips the
  ; page) when nothing is installed or when the run is silent.
  ; -------------------------------------------------------------------------
  Function ytvwChooserCreate
    !insertmacro YTVW_DETECT_INSTALLED $ytvwInstalled

    ${If} $ytvwInstalled == "0"
      Abort
    ${EndIf}
    ${If} ${Silent}
      Abort
    ${EndIf}

    !ifmacrodef MUI_HEADER_TEXT
      !insertmacro MUI_HEADER_TEXT "${YTVW_CHOOSER_TITLE}" "${YTVW_CHOOSER_SUBTITLE}"
    !endif

    nsDialogs::Create 1018
    Pop $ytvwDialog
    ${If} $ytvwDialog == error
      MessageBox MB_OK|MB_ICONSTOP "${YTVW_CHOOSER_DIALOG_FAILED}" /SD IDOK
      Abort
    ${EndIf}

    ${NSD_CreateLabel} 0u 0u 100% 32u "${YTVW_CHOOSER_MESSAGE}"
    Pop $ytvwControl
    ${NSD_CreateRadioButton} 0u 38u 100% 22u "${YTVW_CHOOSER_REINSTALL}"
    Pop $ytvwReinstall
    ${NSD_CreateRadioButton} 0u 62u 100% 22u "${YTVW_CHOOSER_UNINSTALL}"
    Pop $ytvwUninstall
    ${NSD_CreateRadioButton} 0u 86u 100% 22u "${YTVW_CHOOSER_CANCEL}"
    Pop $ytvwCancel

    ${NSD_SetState} $ytvwReinstall ${BST_CHECKED}
    StrCpy $ytvwChoice "reinstall"

    nsDialogs::Show
  FunctionEnd

  ; -------------------------------------------------------------------------
  ; Maps the selection: uninstall runs the real uninstaller with `/S` and
  ; WITHOUT `/KEEP_APP_DATA` (so the ProgramData data tree is removed too) and
  ; exits; cancel exits; reinstall falls through to the template's
  ; `/KEEP_APP_DATA` upgrade path.
  ; -------------------------------------------------------------------------
  Function ytvwChooserLeave
    ${NSD_GetState} $ytvwReinstall $0
    ${If} $0 == ${BST_CHECKED}
      StrCpy $ytvwChoice "reinstall"
    ${EndIf}
    ${NSD_GetState} $ytvwUninstall $0
    ${If} $0 == ${BST_CHECKED}
      StrCpy $ytvwChoice "uninstall"
    ${EndIf}
    ${NSD_GetState} $ytvwCancel $0
    ${If} $0 == ${BST_CHECKED}
      StrCpy $ytvwChoice "cancel"
    ${EndIf}

    ${If} $ytvwChoice == "uninstall"
      ExecWait '"$INSTDIR\${UNINSTALL_FILENAME}" /S _?=$INSTDIR'
      ; A bare Quit exits with NSIS's abort code 2; the template's own
      ; quitSuccess macro clears the error level first for the same reason.
      SetErrorLevel 0
      Quit
    ${ElseIf} $ytvwChoice == "cancel"
      SetErrorLevel 0
      Quit
    ${EndIf}
    ; Reinstall: fall through. installSection.nsh then runs the previous
    ; uninstaller with /KEEP_APP_DATA before installing over it.
  FunctionEnd
!macroend

!endif ; YTVW_NSIS_INCLUDE_GUARD
!endif ; BUILD_UNINSTALLER

; ===========================================================================
; youtubetv-for-windows - profile-removing uninstaller (todos 7-8)
; ===========================================================================
;
; This half of the include compiles ONLY for the uninstaller build
; (`BUILD_UNINSTALLER` is defined by electron-builder when it compiles the
; uninstaller script from the same source tree). It owns a separate variable
; namespace ($ytvwUn*) so the installer half above stays untouched, and it
; defines exactly one template hook: `customUnInstall`, which
; `uninstaller.nsh` invokes after `un.checkAppRunning` (the template already
; waits for the running app to close, in silent and assisted mode alike)
; and before any install-directory/registry/shortcut removal.
;
; UPGRADE VS UNINSTALL: during an installer-driven upgrade,
; `installUtil.nsh:uninstallOldVersion` always executes the previous
; uninstaller as `<uninstaller> /S /KEEP_APP_DATA ... --updated`. The macro
; below parses the uninstaller's own command line for `/KEEP_APP_DATA` and
; returns without touching anything when it is present, so that upgrade path
; alone preserves the data tree and the persistent sign-in profile. There is
; no update-status marker: nothing of that kind is written, read, or kept
; here. A real user-invoked uninstall (Control Panel, Start menu,
; Uninstall.exe, QuietUninstallString) never carries that flag, so only that
; path removes the data tree. Failing open here keeps credentials; it never
; destroys them.
;
; REMOVED TREE (fixed convention):
;   <machine base>\${YTVW_MACHINE_DIR_NAME}
;     == %PROGRAMDATA%\youtubetv-for-windows in production
;     (the machine root, containing users\<key>\profile and
;     users\<key>\userdata for every Windows user)
;
; SCOPE TRAP: the installer half's `YTVW_MACHINE_DIR_NAME` lives INSIDE
; `!ifndef BUILD_UNINSTALLER`, so the uninstaller compile never sees it.
; The uninstaller half therefore re-declares the same `!ifndef`-guarded
; default below instead of assuming the installer half's define is visible.
;
; $PROGRAMDATA is not a built-in NSIS variable in this toolchain (warning
; 6000, promoted to an error by -WX), so the base is read at uninstall time
; with `ReadEnvStr "ProgramData"`. `YTVW_MACHINE_ROOT`, when defined before
; this include, overrides that read so a standalone harness can point the
; removal at a scratch directory; the real build always uses the ProgramData
; environment variable.
;
; BLANK BASE: when the resolved base is blank (missing variable), the removal
; is skipped as a missing-tree no-op (exit 0, nothing touched). A blank base
; would otherwise make the removal target drive-relative
; (`"\youtubetv-for-windows"`), and a drive-relative recursive delete is a
; catastrophic bug, not a style issue. Skipping matches the required
; missing-tree no-op: there is no addressable machine tree to remove.
;
; LOCK FAILURE: after `RMDir /r`, any surviving file under the data tree
; means a handle is still open (the app did not shut down, or a lock
; survived it). The uninstaller then shows the bilingual failure (`/SD IDOK`
; keeps silent uninstalls non-blocking: the message is skipped there and
; only the nonzero exit reports) and aborts instead of silently leaving
; credentials behind. Re-running the uninstaller after closing the app
; completes the removal.
;
; ENCODING: this file is UTF-8 WITH BOM (EF BB BF). makensis reads a
; BOM-less script as ACP and aborts with "Bad text encoding" on the
; Traditional Chinese message below; the BOM makes it read UTF-8.
; ===========================================================================

!ifdef BUILD_UNINSTALLER

!ifndef YTVW_NSIS_UNINSTALL_GUARD
!define YTVW_NSIS_UNINSTALL_GUARD

!ifndef YTVW_MACHINE_DIR_NAME
  !define YTVW_MACHINE_DIR_NAME "youtubetv-for-windows"
!endif

Var ytvwUnParameters
Var ytvwUnKeepFlag
Var ytvwUnBase
Var ytvwUnRoot

; ---------------------------------------------------------------------------
; YTVW_REMOVE_DATA_DIRECTORY
;   Removes the whole machine data tree, except on the upgrade path
;   (`/KEEP_APP_DATA` on the uninstaller command line), where it returns
;   without touching the tree. On a lock failure it reports bilingually and
;   aborts the uninstall with a nonzero exit.
;   Registers: $ytvwUnParameters command line, $ytvwUnKeepFlag flag value,
;   $ytvwUnBase resolved base, $ytvwUnRoot machine root.
; ---------------------------------------------------------------------------
!macro YTVW_REMOVE_DATA_DIRECTORY
  ${GetParameters} $ytvwUnParameters
  ; Initialized so the flag variable is referenced even on the upgrade path;
  ; an unreferenced Var trips NSIS warning 6001, which the packaging
  ; configuration promotes to an error.
  StrCpy $ytvwUnKeepFlag ""
  ClearErrors
  ${GetOptions} $ytvwUnParameters "/KEEP_APP_DATA" $ytvwUnKeepFlag
  ${IfNot} ${Errors}
    Goto ytvwUnRemoveDone
  ${EndIf}
  ClearErrors
  !ifdef YTVW_MACHINE_ROOT
    StrCpy $ytvwUnBase "${YTVW_MACHINE_ROOT}"
  !else
    ReadEnvStr $ytvwUnBase "ProgramData"
  !endif
  ${If} $ytvwUnBase == ""
    ; A blank base would make the removal target drive-relative
    ; (`"\youtubetv-for-windows"`). ReadEnvStr leaves the variable empty when
    ; the environment variable is absent, so the guard covers both the blank
    ; and the missing case. Skipped as a missing-tree no-op: there is no
    ; addressable machine tree to remove.
    ClearErrors
    Goto ytvwUnRemoveDone
  ${EndIf}
  StrCpy $ytvwUnRoot "$ytvwUnBase\${YTVW_MACHINE_DIR_NAME}"
  ClearErrors
  RMDir /r "$ytvwUnRoot"
  ClearErrors
  IfFileExists "$ytvwUnRoot\*.*" ytvwUnRemoveFailed ytvwUnRemoveDone
  ytvwUnRemoveFailed:
  MessageBox MB_OK|MB_ICONEXCLAMATION "無法移除設定檔與應用程式資料，請先關閉應用程式後再執行解除安裝。$\r$\nThe profile and application data could not be removed. Close the app and run the uninstaller again.$\r$\n($ytvwUnRoot)" /SD IDOK
  Abort
  ytvwUnRemoveDone:
!macroend

; ---------------------------------------------------------------------------
; electron-builder hook: runs inside the uninstall section after the
; template's app-running check and before file/registry/shortcut removal.
; ---------------------------------------------------------------------------
!macro customUnInstall
  !insertmacro YTVW_REMOVE_DATA_DIRECTORY
!macroend

!endif ; YTVW_NSIS_UNINSTALL_GUARD
!endif ; BUILD_UNINSTALLER
