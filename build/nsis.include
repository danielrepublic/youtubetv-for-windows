; ===========================================================================
; youtubetv-for-windows - installer hooks and uninstaller data removal
; ===========================================================================
;
; WIRING: electron-builder resolves `nsis.include` against the build resources
; directory (default `build/`), so the effective path is `build/nsis.include`.
; It emits `!include` for this file into the common installer script header,
; i.e. BEFORE the template body. The template invokes the documented hooks:
;
;   installer.nsi:79       -> `!ifmacrodef customInit`        (inside .onInit)
;   multiUserUi.nsh:41     -> `!ifmacrodef customInstallmode` (install-mode page)
;   installSection.nsh:81  -> `!ifmacrodef customInstall`     (end of install)
;   uninstaller.nsh:156    -> `!ifmacrodef customUnInstall`   (uninstall section)
;
; `customInit` is deliberately used (NOT `preInit`): installer.nsi runs it
; after `initMultiUser` and BEFORE `CHECK_APP_RUNNING` and before
; `uninstallOldVersion` / `installApplicationFiles`, so the per-user state it
; restores is already in effect when the first filesystem or registry action
; runs. `customInstall` is retained as an intentionally empty hook so the
; template's `!ifmacrodef customInstall` wiring stays stable.
;
; REQUIRED INCLUDES AT INSERTION TIME (provided by installer.nsi: MUI2 ->
; LogicLib, multiUser.nsh -> FileFunc.nsh; the standalone harnesses include
; them explicitly):
;   LogicLib.nsh   (${If}, ${IfNot}, ...)
;   FileFunc.nsh   (${GetParameters}, ${GetOptions})
;
; TWO HALVES, ONE SOURCE: electron-builder compiles the same source tree
; twice, once as the installer and once as the uninstaller with
; BUILD_UNINSTALLER defined. The installer hooks below are wrapped in
; `!ifndef BUILD_UNINSTALLER`; the profile-removing uninstaller half at the
; bottom is wrapped in `!ifdef BUILD_UNINSTALLER`. The packaging configuration
; passes `-WX` (warnings-as-errors), so NSIS warning 6001 ("unused variable")
; is an error in BOTH compile modes: every `Var` must be referenced in every
; mode in which it is declared.
; ===========================================================================
;
; ---------------------------------------------------------------------------
; STRUCTURE
; ---------------------------------------------------------------------------
;
;   guards                    - evaluated in BOTH compiles; a hostile
;                               per-machine, elevating, or one-click config
;                               aborts the build with an error;
;   !ifndef BUILD_UNINSTALLER - the installer hooks (customInstallMode /
;                               customInit / customInstall);
;   !ifdef  BUILD_UNINSTALLER - the profile-removing uninstaller half
;                               (customUnInstall).
;
; UNINSTALLER BUILD: electron-builder compiles the same source tree a second
; time with BUILD_UNINSTALLER defined. That script never inserts the install
; hooks, so an unused `Var` there trips NSIS warning 6001, which
; electron-builder treats as an ERROR. The whole installer half is therefore
; skipped in the uninstaller build.
; ===========================================================================
;
; ---------------------------------------------------------------------------
; PER-USER-ONLY ENFORCEMENT (todo 7)
; ---------------------------------------------------------------------------
;
; Evaluated against the REAL defines electron-builder passes to makensis on
; the command line, in BOTH the installer and the uninstaller compiles. Any
; one of them being set aborts the BUILD with an error, so a
; per-machine-capable or elevating configuration can never produce an
; installer silently:
;
;   INSTALL_MODE_PER_ALL_USERS       - set only when `perMachine: true`.
;   MULTIUSER_INSTALLMODE_ALLOW_ELEVATION
;                                    - set unless `nsis.allowElevation` is
;                                      false; without it the assisted mode
;                                      page disables the "all users" radio
;                                      for non-admin callers.
;   ONE_CLICK                        - the one-click flow has no install-mode
;                                      page at all; this deliverable is the
;                                      assisted UI.
;
; NOTE: INSTALL_MODE_PER_ALL_USERS_REQUIRED is deliberately NOT guarded: it
; is defined for every assisted build and only declares the per-machine
; code path, never selects it.
; ---------------------------------------------------------------------------
!ifdef INSTALL_MODE_PER_ALL_USERS
  !error "youtubetv-for-windows forbids per-machine installs: perMachine must be false"
!endif
!ifdef MULTIUSER_INSTALLMODE_ALLOW_ELEVATION
  !error "youtubetv-for-windows forbids elevation: nsis.allowElevation must be false"
!endif
!ifdef ONE_CLICK
  !error "youtubetv-for-windows requires the assisted installer: nsis.oneClick must be false"
!endif

!ifndef BUILD_UNINSTALLER

!ifndef YTVW_NSIS_INCLUDE_GUARD
!define YTVW_NSIS_INCLUDE_GUARD

; ---------------------------------------------------------------------------
; customInstallMode (assisted installer only)
;   Called by the template's install-mode page function
;   (multiUserUi.nsh: `!ifmacrodef customInstallmode`) before the page is
;   shown. Forcing $isForceCurrentInstall makes the page select the
;   per-user mode and skip itself entirely, so an interactive install can
;   never choose all-users. (Macro names are case-insensitive in NSIS, so
;   this definition satisfies the lowercase check; proven by probe.)
;   $isForceCurrentInstall is declared by the template's multiUserUi.nsh;
;   this macro is only ever inserted there (or by the install-mode test,
;   which declares the same Var), so no guard is needed.
;   Silent installs never show the page; they are covered by the customInit
;   forcing below.
; ---------------------------------------------------------------------------
!macro customInstallMode
  StrCpy $isForceCurrentInstall "1"
!macroend

; ---------------------------------------------------------------------------
; electron-builder hook: runs inside .onInit, after initMultiUser and before
; CHECK_APP_RUNNING / uninstallOldVersion / installApplicationFiles.
; ---------------------------------------------------------------------------
!macro customInit
  ; Force the per-user mode on EVERY installer run, including silent
  ; invocations and invocations carrying /allusers: initMultiUser may have
  ; selected per-machine above, and this unconditionally restores CurrentUser
  ; before anything touches the filesystem or registry. The setter changes
  ; $installMode and the shell context, but not initMultiUser's installation
  ; state flags. installer.nsi's later silent consumer reads
  ; $hasPerMachineInstallation to decide whether to elevate and restore the
  ; all-users mode, so restore those flags as one per-user state transition.
  ; The template macro is always defined in real builds (multiUser.nsh is
  ; unconditionally included); the guard keeps standalone harnesses
  ; compiling, and the install-mode runtime test proves the guard resolves.
  !ifmacrodef setInstallModePerUser
    !insertmacro setInstallModePerUser
    StrCpy $hasPerMachineInstallation "0"
    StrCpy $hasPerUserInstallation "1"
  !endif
!macroend

; ---------------------------------------------------------------------------
; electron-builder hook: runs at the end of the install section, after all
; files/registry/shortcuts exist. It is kept defined (with an empty body) so
; the template's `!ifmacrodef customInstall` slot still resolves; the
; launcher update handoff that used to act here is gone.
; ---------------------------------------------------------------------------
!macro customInstall
!macroend

!endif ; YTVW_NSIS_INCLUDE_GUARD
!endif ; BUILD_UNINSTALLER

; ===========================================================================
; youtubetv-for-windows - profile-removing uninstaller (todo 7)
; ===========================================================================
;
; This half of the include compiles ONLY for the uninstaller build
; (`BUILD_UNINSTALLER` is defined by electron-builder when it compiles the
; uninstaller script from the same source tree). It owns a separate variable
; namespace ($ytvwUn*) so the installer half above stays untouched, and it
; defines exactly one template hook: `customUnInstall`, which
; `uninstaller.nsh` invokes after `un.checkAppRunning` (the template already
; waits for the running app to close, in silent and assisted mode alike)
; and before any install-directory/registry/shortcut removal.
;
; UPGRADE VS UNINSTALL: during an installer-driven upgrade,
; `installUtil.nsh:uninstallOldVersion` always executes the previous
; uninstaller as `<uninstaller> /S /KEEP_APP_DATA ... --updated`. The macro
; below parses the uninstaller's own command line for `/KEEP_APP_DATA` and
; returns without touching anything when it is present, so the persistent
; sign-in profile (and the sibling update-status markers) SURVIVE updates.
; A real user-invoked uninstall (Control Panel, Start menu, Uninstall.exe,
; QuietUninstallString) never carries that flag, so only that path removes
; the data tree. Failing open here keeps credentials; it never destroys
; them.
;
; REMOVED TREES (fixed conventions):
;   ${YTVW_DATA_ROOT}\${YTVW_DATA_DIR_NAME}
;     == %LOCALAPPDATA%\youtubetv-for-windows in production
;     (profile + updates + update-status + diagnostics)
;   ${YTVW_ROAMING_DATA_ROOT}\${YTVW_ROAMING_DATA_DIR_NAME}
;     == %APPDATA%\youtubetv-for-windows in production
;     (Electron's default userData cache and configuration)
;
; LOCK FAILURE: after `RMDir /r`, any surviving file under the data tree
; means a handle is still open (the app did not shut down, or a lock
; survived it). The uninstaller then shows the bilingual failure (`/SD IDOK`
; keeps silent uninstalls non-blocking: the message is skipped there and
; only the nonzero exit reports) and aborts instead of silently leaving
; credentials behind. Re-running the uninstaller after closing the app
; completes the removal.
;
; ENCODING: this file is UTF-8 WITH BOM (EF BB BF). makensis reads a
; BOM-less script as ACP and aborts with "Bad text encoding" on the
; Traditional Chinese message below; the BOM makes it read UTF-8.
; ===========================================================================

!ifdef BUILD_UNINSTALLER

!ifndef YTVW_NSIS_UNINSTALL_GUARD
!define YTVW_NSIS_UNINSTALL_GUARD

!ifndef YTVW_DATA_DIR_NAME
  !define YTVW_DATA_DIR_NAME "youtubetv-for-windows"
!endif
!ifndef YTVW_DATA_ROOT
  !define YTVW_DATA_ROOT "$LOCALAPPDATA"
!endif
!ifndef YTVW_ROAMING_DATA_DIR_NAME
  !define YTVW_ROAMING_DATA_DIR_NAME "youtubetv-for-windows"
!endif
!ifndef YTVW_ROAMING_DATA_ROOT
  !define YTVW_ROAMING_DATA_ROOT "$APPDATA"
!endif

Var ytvwUnParameters
Var ytvwUnKeepFlag

; ---------------------------------------------------------------------------
; YTVW_REMOVE_DATA_DIRECTORY
;   Removes both whole per-user data trees, except on the upgrade path
;   (`/KEEP_APP_DATA` on the uninstaller command line), where it returns
;   without touching either tree. On a lock failure it reports bilingually and
;   aborts the uninstall with a nonzero exit.
; ---------------------------------------------------------------------------
!macro YTVW_REMOVE_DATA_DIRECTORY
  ${GetParameters} $ytvwUnParameters
  ; Initialized so the flag variable is referenced even on the upgrade path;
  ; an unreferenced Var trips NSIS warning 6001, which the packaging
  ; configuration promotes to an error.
  StrCpy $ytvwUnKeepFlag ""
  ClearErrors
  ${GetOptions} $ytvwUnParameters "/KEEP_APP_DATA" $ytvwUnKeepFlag
  ${IfNot} ${Errors}
    Goto ytvwUnRemoveDone
  ${EndIf}
  ClearErrors
  RMDir /r "${YTVW_DATA_ROOT}\${YTVW_DATA_DIR_NAME}"
  RMDir /r "${YTVW_ROAMING_DATA_ROOT}\${YTVW_ROAMING_DATA_DIR_NAME}"
  ClearErrors
  IfFileExists "${YTVW_DATA_ROOT}\${YTVW_DATA_DIR_NAME}\*.*" ytvwUnRemoveFailed 0
  IfFileExists "${YTVW_ROAMING_DATA_ROOT}\${YTVW_ROAMING_DATA_DIR_NAME}\*.*" ytvwUnRemoveFailed ytvwUnRemoveDone
  ytvwUnRemoveFailed:
  MessageBox MB_OK|MB_ICONEXCLAMATION "無法移除設定檔與應用程式資料，請先關閉應用程式後再執行解除安裝。$\r$\nThe profile and application data could not be removed. Close the app and run the uninstaller again.$\r$\n(${YTVW_DATA_ROOT}\${YTVW_DATA_DIR_NAME})$\r$\n(${YTVW_ROAMING_DATA_ROOT}\${YTVW_ROAMING_DATA_DIR_NAME})" /SD IDOK
  Abort
  ytvwUnRemoveDone:
!macroend

; ---------------------------------------------------------------------------
; electron-builder hook: runs inside the uninstall section after the
; template's app-running check and before file/registry/shortcut removal.
; ---------------------------------------------------------------------------
!macro customUnInstall
  !insertmacro YTVW_REMOVE_DATA_DIRECTORY
!macroend

!endif ; YTVW_NSIS_UNINSTALL_GUARD
!endif ; BUILD_UNINSTALLER
