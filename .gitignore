# Dependencies (install is reproducible from the committed package-lock.json)
node_modules/

# Generated build output
dist/
release-output/
*.tsbuildinfo

# Ignored release/QA evidence (recorded locally, never committed)
release-evidence/
/*.log

# Secrets: release signing material must never enter the repository
.env
.env.*
*.pem
*.key
*.pfx
*.p12

# Agent session state (plans, drafts, notepads, run continuation) is never committed
.omo/

# Editor, OS, and stray tool output
.DS_Store
Thumbs.db
.vscode/
.idea/
.playwright-mcp/
test-results/
playwright-report/
